        <!-- SECCIÓN CONFIRMAR ASISTENCIA -->
        <div id="seccion-confirmar" class="mt-2">
          <!-- SECCIÓN CONFIRMAR ASISTENCIA -->
          <div id="seccion-confirmar" class="mt-2">
            <!-- Texto de invitación a confirmar -->
            <p
              class="font-charm text-xl md:text-xl text-[#ffffff] leading-relaxed mb-2"
              id="texto-confirmar"
            >
              Tu presencia es muy importante para mí. Por favor, <span
                class="text-[#ffffff]">confirma tu asistencia</span
              > para compartir juntos este día tan especial.
            </p>

            <!-- TEXTO DE CONFIRMAR ASISTENCIA -->
            <p
              class="font-charm pt-10 text-xl md:text-3xl lg:text-4xl text-[#C7CCD4] font-bold mb-8"
              id="mensaje-confirmar"
            >
              Por favor, haz click para confirmar asistencia
            </p>

            <!-- BOTÓN CONFIRMAR ASISTENCIA -->
            <div class="flex justify-center mb-10" id="boton-confirmar">
              <a
                href="https://wa.me/59160957000?text=Me%20complace%20confirmar%20mi%20asistencia%20a%20los%2015%20a%C3%B1os%20de%20Sheyla%20Stefany%2C%20que%20se%20realizar%C3%A1%20el%20s%C3%A1bado%2028%20de%20noviembre%20de%202026%2C%20estar%C3%A9%20sin%20falta%2C%20muchas%20gracias."
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Confirmar asistencia por WhatsApp"
                title="Confirmar asistencia por WhatsApp"
                class="inline-flex items-center gap-3 bg-gradient-to-b from-[#F4F6F9] via-[#C7CCD4] to-[#9AA3B0] text-[#1a2a4a] font-bold border border-white/70 font-charm text-xl md:text-2xl px-8 py-2 rounded-full transition-all duration-300 hover:scale-105 hover:brightness-110 shadow-[0_6px_18px_rgba(199,204,212,0.35),inset_0_1px_0_rgba(255,255,255,0.9)] hover:shadow-[0_8px_24px_rgba(230,234,240,0.55),inset_0_1px_0_rgba(255,255,255,0.9)]"
              >
                <span>Confirmar Asistencia</span>
              </a>
            </div>

            <!-- MENSAJE FINAL -->
            <p
              class="font-charm pt-4 text-2xl md:text-3xl lg:text-4xl text-[#ffffff] font-bold mb-8"
              id="mensaje-final"
            >
              ¡Los espero con mucho cariño!
            </p>
          </div>

          <!-- MENSAJE FINAL -->
          <!-- <p
              class="font-charm pt-10 text-2xl md:text-3xl lg:text-4xl text-[#ffffff] font-bold mb-8"
              id="mensaje-final"
            >
              ¡Los espero con mucho cariño!
