        <!-- Resplandor del card -->
        <div
          class="absolute -inset-1 bg-gradient-to-br from-[#95303a]/5 via-transparent to-[#C7CCD4]/5 rounded-3xl blur-xl -z-10"
        >
        </div>
      </div>
    </div>
  </div>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    if (typeof window !== "undefined") {
      document.addEventListener("DOMContentLoaded", () => {
        console.log("💌 Iniciando sección de despedida...");

        // 🎯 ESTADO INICIAL
        gsap.set("#flores-arriba-despedida", {
          opacity: 0,
          y: -30,
          scale: 0.8,
        });
        gsap.set("#card-despedida", { opacity: 0, y: 40, scale: 0.95 });
        gsap.set("#mensaje-despedida", {
          opacity: 0,
          y: 30,
          filter: "blur(5px)",
        });
        gsap.set("#linea-decorativa", { opacity: 0, scale: 0.5 });
        gsap.set("#texto-confirmar", { opacity: 0, y: 20 });
        gsap.set("#mensaje-confirmar", { opacity: 0, scale: 0.9, y: 20 });
        gsap.set("#boton-confirmar", { opacity: 0, scale: 0.8, y: 20 });
        gsap.set("#mensaje-final", { opacity: 0, scale: 0.9, y: 20 });

        // ✨ ANIMACIÓN SIMULTÁNEA Y ELEGANTE
        ScrollTrigger.create({
          trigger: "#flores-arriba-despedida",
          start: "top 85%",
          end: "top 20%",
          onEnter: () => {
            const tl = gsap.timeline();

            // Todos los elementos aparecen al mismo tiempo
            tl.to("#flores-arriba-despedida", {
              opacity: 0.8,
              y: 0,
              scale: 1,
              duration: 0.8,
              ease: "back.out(1.5)",
            })
              .to(
                "#card-despedida",
                {
                  opacity: 1,
                  y: 0,
                  scale: 1,
                  duration: 0.8,
                  ease: "power3.out",
                },
                0,
              )
              .to(
                "#mensaje-despedida",
                {
                  opacity: 1,
                  y: 0,
                  filter: "blur(0px)",
                  duration: 0.8,
                  ease: "power2.out",
                },
                0,
              )
              .to(
                "#linea-decorativa",
                {
                  opacity: 1,
                  scale: 1,
                  duration: 0.8,
                  ease: "back.out(1.5)",
                },
                0,
              )
              .to(
                "#texto-confirmar",
                {
                  opacity: 1,
                  y: 0,
                  duration: 0.8,
                  ease: "power2.out",
                },
                0,
              )
              .to(
                "#mensaje-confirmar",
                {
                  opacity: 1,
                  scale: 1,
                  y: 0,
                  duration: 0.8,
                  ease: "back.out(1.5)",
                },
                0,
              )
              .to(
                "#boton-confirmar",
                {
                  opacity: 1,
                  scale: 1,
                  y: 0,
                  duration: 0.8,
                  ease: "back.out(1.5)",
                },
                0,
              )
              .to(
                "#mensaje-final",
                {
                  opacity: 1,
                  scale: 1,
                  y: 0,
                  duration: 0.8,
                  ease: "elastic.out(1, 0.5)",
                },
                0,
              );

            // 🌸 ANIMACIONES CONTINUAS
            gsap.to("#linea-decorativa svg", {
              scale: 1.2,
              duration: 1.5,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
              delay: 0.8,
            });

            gsap.to("#boton-confirmar img", {
              scale: 1.05,
              y: -3,
              duration: 2,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
              delay: 0.8,
            });

            gsap.to("#mensaje-final", {
              textShadow: "0 0 15px rgba(142, 151, 166, 0.4)",
              duration: 2,
              ease: "sine.inOut",
              yoyo: true,
              repeat: -1,
              delay: 0.8,
            });
          },
          onLeaveBack: () => {
            gsap.set("#flores-arriba-despedida", {
              opacity: 0,
              y: -30,
              scale: 0.8,
            });
            gsap.set("#card-despedida", { opacity: 0, y: 40, scale: 0.95 });
            gsap.set("#mensaje-despedida", {
              opacity: 0,
              y: 30,
              filter: "blur(5px)",
            });
            gsap.set("#linea-decorativa", { opacity: 0, scale: 0.5 });
            gsap.set("#texto-confirmar", { opacity: 0, y: 20 });
            gsap.set("#mensaje-confirmar", { opacity: 0, scale: 0.9, y: 20 });
            gsap.set("#boton-confirmar", { opacity: 0, scale: 0.8, y: 20 });
            gsap.set("#mensaje-final", { opacity: 0, scale: 0.9, y: 20 });
          },
        });

        console.log("💌✨ ¡Sección de despedida activada!");
      });
    }
  </script>

  <style>
    #card-despedida:hover {
      box-shadow: 0 20px 40px rgba(142, 151, 166, 0.15);
      transition: box-shadow 0.5s ease;
    }

    #mensaje-despedida span {
      transition: all 0.3s ease;
    }

    #mensaje-despedida span:hover {
      color: #C7CCD4;
      text-shadow: 0 0 10px rgba(142, 151, 166, 0.3);
    }
  </style>
</section>
